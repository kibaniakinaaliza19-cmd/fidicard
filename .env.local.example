# Copier ce fichier en `.env.local` et remplir (jamais commité — voir .gitignore).
# Sans ces clés, l'app tourne entièrement en mode démo local.

# --- Analyse IA de l'import de carte (app/api/analyze-card) -----------------
# Sans cette clé, l'import fonctionne quand même avec le moteur local (OCR).
# La clé reste côté serveur : elle n'est jamais envoyée au navigateur.
ANTHROPIC_API_KEY=

# Optionnel : modèle de vision de la route (défaut : claude-opus-4-8, le plus
# précis ; "claude-sonnet-4-6" réduit le coût par import).
# ANTHROPIC_VISION_MODEL=

# --- Backend Supabase (facultatif en mode démo) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: powers a real OpenAI-backed Fidi AI instead of the built-in
# heuristic in src/lib/ai-heuristic.ts.
OPENAI_API_KEY=
