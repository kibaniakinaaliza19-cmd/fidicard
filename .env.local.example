# Copier ce fichier en `.env.local` et remplir (jamais commité — voir .gitignore).
# Sans ces clés, l'app tourne entièrement en mode démo local.

# --- Analyse IA de l'import de carte (app/api/analyze-card) -----------------
# Sans cette clé, l'import fonctionne quand même avec le moteur local (OCR).
# La clé reste côté serveur : elle n'est jamais envoyée au navigateur.
ANTHROPIC_API_KEY=

# Optionnel : modèle de vision de la route (défaut : claude-opus-4-8, le plus
# précis ; "claude-sonnet-4-6" réduit le coût par import).
# ANTHROPIC_VISION_MODEL=

# --- FidiIA : choix du fournisseur de modèle (src/lib/fidiia) ----------------
# "mock" = fournisseur simulé, déterministe, aucun appel réseau, aucun coût.
# C'est la valeur par défaut et la seule implémentée à ce stade : le squelette
# tourne de bout en bout sans clé. Un vrai moteur s'ajoutera à côté de mock.ts.
FIDIIA_PROVIDER=mock

# Pour brancher OpenAI : FIDIIA_PROVIDER=openai, puis les deux lignes suivantes.
# Le modèle n'a AUCUNE valeur par défaut dans le code — un identifiant deviné
# coûte cher ou échoue. Listez ceux auxquels votre clé donne accès :
#     npm run fidiia:modeles
# Clé serveur uniquement : jamais NEXT_PUBLIC_, jamais commitée.
OPENAI_API_KEY=
FIDIIA_OPENAI_MODEL=
# Facultatif : un modèle distinct pour l'analyse d'image (défaut : le même).
FIDIIA_OPENAI_MODEL_VISION=

# --- Backend Supabase (facultatif en mode démo) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Assistant FidiCard conversationnel (app/api/assistant) — OpenAI --------
# Avec cette clé, l'Assistant du Designer IA (/carte) tourne sur un vrai
# modèle ChatGPT. Sans elle, l'assistant local déterministe prend le relais.
# La clé reste côté serveur : jamais envoyée au navigateur.
OPENAI_API_KEY=

# Optionnel : modèle OpenAI de l'assistant (défaut : gpt-4o-mini).
# Mets ici le modèle de ton compte, ex. gpt-5, gpt-4o, gpt-4.1.
# OPENAI_ASSISTANT_MODEL=gpt-4o
